# Copy to .env on the server and fill in what you use. Every key is optional.

# --- Supabase (Dashboard -> Project Settings -> API) ---
# Stores every call request and message, and runs the admin sign-in with forgot-password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: server only, never share it or put it in the browser
SUPABASE_SERVICE_ROLE_KEY=
# Emails allowed into /admin, comma-separated (the user must also exist in Supabase Auth)
ADMIN_EMAILS=

# Fallback admin sign-in when Supabase is not set: one shared password. Leave empty otherwise.
ADMIN_PASSWORD=

# Email notifications (Gmail: smtp.gmail.com, port 465, and a Google "App password").
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where studio notifications go (defaults to the founder's email)
NOTIFY_EMAIL=
# Sender shown on emails (defaults to SMTP_USER)
MAIL_FROM=

# Optional: an n8n (or Make/Zapier) webhook that receives every booking and message as JSON
N8N_WEBHOOK_URL=

# Where bookings and messages are stored (defaults to ./data)
DATA_DIR=
