# Copy to .env on the server and fill in what you use. Every key is optional.

# Admin page at /admin (bookings and messages). Leave empty to keep it off.
ADMIN_PASSWORD=

# Email notifications (Gmail: smtp.gmail.com, port 465, and a Google "App password").
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where studio notifications go (defaults to the founder's email)
NOTIFY_EMAIL=
# Sender shown on emails (defaults to SMTP_USER)
MAIL_FROM=

# Optional: an n8n (or Make/Zapier) webhook that receives every booking and message as JSON
N8N_WEBHOOK_URL=

# Where bookings and messages are stored (defaults to ./data)
DATA_DIR=
